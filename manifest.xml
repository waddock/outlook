<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="MessageCompose">
  <Id>bce7d3fc-1f98-4f43-a68b-760b8826d235</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Kontain</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="MetaTag Mailer"/>
  <Description DefaultValue="Force tagging of emails with Project Code and Email Type before sending."/>
  
  <IconUrl DefaultValue="https://via.placeholder.com/32"/>
  <HighResolutionIconUrl DefaultValue="https://via.placeholder.com/64"/>
  <SupportUrl DefaultValue="https://kontainit.co.uk"/>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemCompose">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://waddock.github.io/outlook/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
</OfficeApp>
